 &NEWRUN
  Head='WHPS LINAC 1nC 10ps 2ps 0.5mm 2 laser pulse with space charge 0.4um 20K'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!,
  RUN=1 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!,
  Loop=F,
  Nloop=1,
  Distribution='WHPS_LINAC_1nC_10k_27_beforeAX.ini' !'WHPS_LINAC_1nC_10k_Shanghai2.ini' !'WHPS_LINAC_1nC_10k_1.ini' !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!,
  Xoff=0.0,
  Yoff=0.0,
  TRACK_ALL=T,
  PHASE_SCAN=F,
  AUTO_PHASE=T,  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!,
  check_ref_part=F,
  H_max=0.001,
  H_min=0.0,
  !Qbunch=0.1 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 /

 &OUTPUT
  ZSTART=28.5!31!8.5!0.0,
  ZSTOP=42!35!8.5!40!2!10!14.75!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!14.75,
  Zemit=1000.0,
  Zphase=10!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!10,
  !Screen(1)=0.155    	! exit of the gun
  !Screen(2)=1.72     	! middle of SRR chamber(?)
  !Screen(3)=2.86     	! position of straight screen monitor
  !Screen(4)=10.85    	! 10 cm before chicane
  !Screen(5)=12.35    	! middle of chicane
  !Screen(6)=13.80    	! 5 cm after chicane
  Lmagnetized=F!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!,
  !Lproject_emit=T!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  EmitS=T,
  PhaseS=T,
  TrackS=T,
  RefS=T,
  TcheckS=T,
  CathodeS=T,
  High_res=T,
 /

&SCAN
  LScan=F!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!F,
  !Scan_para='MaxE(1)',    S_min=-120.0,  S_max=-100.0,  S_numb=10,!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !Scan_para='Phi(1)',        S_min=-45.00,  S_max=-25.00,  S_numb=10,!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  Scan_para='MaxE(9)',    S_min=40,  S_max=48,  S_numb=9,!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!0.1777,
  !Scan_para='S_pos(1)',    S_min=-0.05,   S_max=0.05,    S_numb=8,!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  FOM(1)='bunch charge',
  FOM(2)='statistics: number of backward traveling particles',
  FOM(3)='horizontal rms spot size',
  FOM(4)='longitudinal rms emittance',
  FOM(5)='rms bunch length',
  FOM(6)='mean beam energy',
  FOM(7)='rms beam energy spread',
  FOM(8)='horizontal rms emittance',
  FOM(9)='vertical rms emittance',
  !FOM(10)='statistics: number of lost particles on an aperture'
 /

 &CHARGE
  Loop=F,
  LSPCH=T!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!T,
  LSPCH3D=T,
  L2D_3D=T,
  z_trans=10.85,
  Nrad=10,
  Nlong_in=20,
  Cell_var=2.0,
  min_grid=0,
  Max_scale=0.05,
  Max_count=40,
  Lmirror=T,
  N_min=100,
 /

